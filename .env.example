# CTN backend configuration.
# Copy to backend/.env (or export these) and fill in real values.
# Every setting has a development default; the ones marked REQUIRED are
# enforced at startup when ENVIRONMENT=production.

# ── Environment ────────────────────────────────────────────────────────────
ENVIRONMENT=development                 # development | production

# ── Auth ───────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=
TOKEN_EXPIRE_DAYS=7

# Session cookie. SameSite=None requires Secure, so leave COOKIE_SECURE unset
# in local development or the browser will silently drop the cookie.
COOKIE_SECURE=                          # defaults to true in production
COOKIE_SAMESITE=                        # defaults to none when secure, else lax
COOKIE_DOMAIN=                          # e.g. .ctn.org

LOGIN_RATE_LIMIT=10/minute
SIGNUP_RATE_LIMIT=5/minute
CHAIN_WRITE_RATE_LIMIT=2/minute

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated exact origins. Do not use wildcards: the API sends
# credentials, so any allowed origin can act on behalf of a signed-in user.
CORS_ORIGINS=http://localhost:8000,https://your-frontend.example.com

# ── Database ───────────────────────────────────────────────────────────────
# Local development: a file relative to backend/.
DATABASE_URL=sqlite:///./ctn_v3.db

# Production: point this INSIDE a mounted volume, or every deploy starts from an
# empty database. Note the four slashes — three for the scheme, one for the
# absolute path. With a Railway volume mounted at /data:
#   DATABASE_URL=sqlite:////data/ctn.db
#
# Railway sets RAILWAY_VOLUME_MOUNT_PATH automatically; set PERSISTENT_DATA_DIR
# instead on hosts that do not, so the startup check knows where the volume is.
# PERSISTENT_DATA_DIR=/data

# ── Seeding ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@ctn.org
ADMIN_PASSWORD=                         # REQUIRED in production
SEED_DEMO_DATA=true                     # defaults to false in production
DEMO_INSTALLER_EMAIL=demo@installer.ctn
DEMO_INSTALLER_PASSWORD=demo-installer-2024

# ── Blockchain ─────────────────────────────────────────────────────────────
# Without PRIVATE_KEY the API runs read-only: minting and retirement return 503
# rather than failing mid-transaction.
PRIVATE_KEY=
# CarbonCreditV2, where new credits are minted.
CONTRACT_ADDRESS=0x890b51626Cc77E41d83fCaa147CF57955d62fA1c
CONTRACT_VERSION=2
# The original V1 contract. Credits minted there before the move to V2 stay
# readable and retirable on it.
LEGACY_CONTRACT_ADDRESS=0x1b4F5A7CEf1c2CFb914A5642CC82F887AB0C7Cf6
AMOY_RPC=https://polygon-amoy-bor-rpc.publicnode.com
EXPLORER=https://amoy.polygonscan.com
TX_RECEIPT_TIMEOUT_SECONDS=180
# A mint claim with no broadcast transaction is considered abandoned after this.
MINT_CLAIM_TTL_SECONDS=600
# Custody wallet for demo credits. Defaults to the PRIVATE_KEY's address.
DEMO_INSTALLER_WALLET=

# ── IPFS (Pinata) ──────────────────────────────────────────────────────────
# Without these, certificates are hashed locally and marked as unpinned
# instead of being given a fake CID.
PINATA_API_KEY=
PINATA_SECRET=

# ── Carbon accounting and pricing ──────────────────────────────────────────
EMISSION_FACTOR=0.82                    # kg CO2/kWh; frozen onto every reading at ingestion
EMISSION_FACTOR_SOURCE=CEA CO2 Baseline Database for the Indian Power Sector, v19.0
EMISSION_FACTOR_VINTAGE=FY2022-23
KG_CO2_PER_CREDIT=1000                  # one credit = one tonne
CREDIT_VALUE_USD=5.0
USD_TO_INR=83.0

# ── Settlement split ───────────────────────────────────────────────────────
# Basis points; must total 10000 or the API refuses to start. Keep in step with
# the split the CTNSettlement contract was deployed with.
SPLIT_SELLER_BPS=7000                   # the generator who produced the credit
SPLIT_TREASURY_BPS=2000                 # CTN treasury
SPLIT_RESERVE_BPS=1000                  # operational reserve

# ── Device onboarding ──────────────────────────────────────────────────────
# How long a pairing code stays redeemable after a seller generates it.
ENROLLMENT_CODE_TTL_MINUTES=60
ENROLL_RATE_LIMIT=10/minute
INGEST_RATE_LIMIT=120/minute

# Whether a self-enrolled device's credits can be sold before an operator has
# confirmed the installation. A signature proves a reading came from a given
# device, not that the device measures a real array, so this stays off unless
# every device is already known to you.
TRUST_SELF_ENROLLED_DEVICES=false

# ── Physical plausibility ──────────────────────────────────────────────────
# A signature proves who produced a reading, not that it could be true.
MAX_CLOCK_SKEW_SECONDS=300              # how far ahead of server time a reading may be
MAX_READING_AGE_HOURS=72                # backfill window for buffered readings
DEFAULT_RATED_CAPACITY_KW=100           # bound for devices that did not declare one
CAPACITY_TOLERANCE=1.10                 # headroom over nameplate
MIN_PLAUSIBILITY_INTERVAL_SECONDS=900   # shortest interval the bound is applied over
METER_CONTINUITY_TOLERANCE_WH=1         # V2: energy vs meter counter advance

# ── Anomaly screening ──────────────────────────────────────────────────────
# Flags, never rejects: a flagged reading holds its credit for human review.
ANOMALY_SCREENING=true
ANOMALY_MIN_HISTORY=96
ANOMALY_HISTORY_WINDOW=2880
ANOMALY_ROBUST_Z=6.0
ANOMALY_FLATLINE_RUN=12
ANOMALY_NIGHT_ELEVATION_DEG=-2.0


# ── Marketplace ────────────────────────────────────────────────────────────
SELL_THRESHOLD=1
RESERVATION_TIMEOUT_MINUTES=15
